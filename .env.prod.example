# chronoq production environment — copy to .env.prod and fill in real values.
# NEVER commit the filled-in .env.prod. Only this .example belongs in git.

# ===== Django =====
DJANGO_SETTINGS_MODULE=chronoq.settings.prod
DJANGO_DEBUG=False
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
DJANGO_LOG_LEVEL=INFO

# TLS: keep False for a plain-HTTP box BEFORE a cert is wired (otherwise every
# request, health checks included, hits an infinite redirect). Flip to True the
# moment HTTPS terminates in front of this app.
DJANGO_SECURE_SSL_REDIRECT=False

# ===== Secrets at rest (Fernet) =====
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# First key encrypts new writes; list older keys after it (comma-separated) to
# decrypt during rotation.
FIELD_ENCRYPTION_KEYS=CHANGE-ME-fernet-key

# ===== Prometheus multiprocess (must match the compose volume mount path) =====
PROMETHEUS_MULTIPROC_DIR=/app/prometheus_multiproc

# ===== Gunicorn =====
WEB_CONCURRENCY=2

# ===== Database =====
POSTGRES_DB=chronoq
POSTGRES_USER=chronoq
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DJANGO_CONN_MAX_AGE=60

# ===== Redis / Celery =====
# DB map: 0 cache/breaker, 1 broker, 2 results, 4 channels.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CHANNELS_REDIS_URL=redis://redis:6379/4

# ===== CORS (the frontend's public origin) =====
CORS_ALLOWED_ORIGINS=https://your-domain.example

# ===== Scheduler =====
SCHEDULER_JITTER_SECONDS=15
